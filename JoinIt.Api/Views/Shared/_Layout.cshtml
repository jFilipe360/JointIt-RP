<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - JoinIt API</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --primary: #0f172a;
            --secondary: #1e293b;
            --gold: #d4af37;
            --background: #f8fafc;
            --text: #1f2937;
            --muted: #6b7280;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            background: var(--background);
            color: var(--text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .api-navbar {
            background: var(--primary);
            box-shadow: 0 2px 12px rgba(15, 23, 42, 0.15);
        }

        .api-brand {
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
            text-decoration: none;
        }

        .api-brand span {
            color: var(--gold);
        }

        .api-main {
            flex: 1;
            padding-top: 2rem;
            padding-bottom: 3rem;
        }

        .api-footer {
            padding: 1.25rem 0;
            background: var(--primary);
            color: rgba(255, 255, 255, 0.75);
            text-align: center;
        }

        .api-footer span {
            color: var(--gold);
        }

        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background-color: var(--gold);
            border-color: var(--gold);
            color: #111827;
        }

        .api-hero {
            padding: 3rem 1.5rem;
        }

        .api-hero-kicker {
            color: var(--gold);
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.12em;
        }

        .api-hero-title {
            color: var(--primary);
            font-weight: 700;
            letter-spacing: -0.03em;
        }

        .api-hero-text {
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }

        .api-feature-card {
            height: 100%;
            border: 0;
            border-radius: 20px;
            background: white;
            box-shadow: 0 5px 22px rgba(15, 23, 42, 0.07);
            transition: transform 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .api-feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(15, 23, 42, 0.11);
        }

        .api-feature-card h2 {
            color: var(--primary);
        }

        .api-feature-icon {
            color: var(--gold);
            font-size: 2rem;
        }
        .api-about-card {
            border: 0;
            border-radius: 20px;
            background: white;
            box-shadow: 0 5px 22px rgba(15, 23, 42, 0.07);
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar api-navbar">
            <div class="container">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="api-brand">
                    Join<span>It</span> API
                </a>
            </div>
        </nav>
    </header>

    <main class="api-main">
        @RenderBody()
    </main>

    <footer class="api-footer">
        <div class="container">
            <a asp-controller="Home"
               asp-action="Privacy"
               class="text-reset text-decoration-none">
                © 2026 Join<span>It</span> API • Sobre
            </a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>