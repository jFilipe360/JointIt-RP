@page
@model IndexModel
@{
    ViewData["Title"] = "Início";
}

<section class="home-hero p-4 p-md-5 mb-5">
    <div class="home-hero-content py-md-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <p class="hero-kicker mb-2">
                    BEM-VINDO AO JOINIT
                </p>

                <h1 class="hero-title mb-4">
                    Encontra eventos.
                    <span class="hero-highlight">Conhece pessoas.</span>
                    Vive novas experiências.
                </h1>

                <p class="lead text-white-50 mb-4">
                    Descobre eventos perto de ti ou cria o teu próprio
                    encontro e junta pessoas com os mesmos interesses.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-page="/Eventos/Index"
                       class="btn btn-warning btn-lg px-4">
                        Explorar eventos
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Eventos/Create"
                           class="btn btn-outline-light btn-lg px-4">
                            Criar evento
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Register"
                           class="btn btn-outline-light btn-lg px-4">
                            Criar conta
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="section-kicker mb-1">
                DESCOBRE
            </p>

            <h2 class="section-title mb-0">
                Próximos eventos
            </h2>
        </div>

        <a asp-page="/Eventos/Index"
           class="btn btn-outline-primary">
            Ver todos
        </a>
    </div>

    @if (Model.ProximosEventos.Any())
    {
        <div class="row g-4">
            @foreach (var evento in Model.ProximosEventos)
            {
                var descricao = evento.Descricao;

                if (descricao.Length > 120)
                {
                    descricao = descricao[..120] + "...";
                }

                var participantes = evento.Participantes.Count(
                    p => p.Estado == JoinIt.Web.Enums.EstadoPedido.Aceite);

                <div class="col-12 col-md-6 col-lg-4">
                    <article class="card evento-home-card h-100">
                        <div class="evento-card-topo"></div>

                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var categoria in evento.EventosCategorias
                                        .Take(2))
                                    {
                                        <span class="categoria-badge">
                                            @categoria.Categoria.Nome
                                        </span>
                                    }
                                </div>

                                <small class="text-muted text-nowrap">
                                    @evento.DataHora.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <h3 class="h5 fw-bold mb-2">
                                @evento.Titulo
                            </h3>

                            <p class="text-muted flex-grow-1">
                                @descricao
                            </p>

                            <div class="evento-meta mb-3">
                                <div>
                                    <strong>Data</strong>
                                    <span>
                                        @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <div>
                                    <strong>Local</strong>
                                    <span>@evento.Local</span>
                                </div>

                                <div>
                                    <strong>Participantes</strong>
                                    <span>
                                        @participantes / @evento.NumMaxParticipantes
                                    </span>
                                </div>
                            </div>

                            <a asp-page="/Eventos/Details"
                               asp-route-id="@evento.Id"
                               class="btn btn-primary w-100">
                                Ver detalhes
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="home-empty-state">
            <h3 class="h5 fw-bold">
                Ainda não existem próximos eventos públicos.
            </h3>

            <p class="text-muted mb-3">
                Sê o primeiro a criar um novo evento.
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Eventos/Create"
                   class="btn btn-primary">
                    Criar evento
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-primary">
                    Iniciar sessão
                </a>
            }
        </div>
    }
</section>

<section class="como-funciona-section mb-4">
    <div class="text-center mb-4">
        <p class="section-kicker mb-1">
            SIMPLES E RÁPIDO
        </p>

        <h2 class="section-title">
            Como funciona
        </h2>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="como-funciona-card h-100 text-center p-4">
                <div class="passo-numero">1</div>

                <h3 class="h5 fw-bold">
                    Cria a tua conta
                </h3>

                <p class="text-muted mb-0">
                    Regista-te gratuitamente e prepara o teu perfil.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="como-funciona-card h-100 text-center p-4">
                <div class="passo-numero">2</div>

                <h3 class="h5 fw-bold">
                    Encontra um evento
                </h3>

                <p class="text-muted mb-0">
                    Pesquisa eventos por categoria, data ou localização.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="como-funciona-card h-100 text-center p-4">
                <div class="passo-numero">3</div>

                <h3 class="h5 fw-bold">
                    Participa
                </h3>

                <p class="text-muted mb-0">
                    Junta-te ao evento, conversa no chat e conhece pessoas.
                </p>
            </div>
        </div>
    </div>
</section>