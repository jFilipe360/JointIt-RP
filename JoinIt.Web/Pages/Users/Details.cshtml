@page
@using JoinIt.Web.Enums
@using JoinIt.Web.ViewModels
@model JoinIt.Web.Pages.Users.DetailsModel

@{
    ViewData["Title"] = "Perfil";

    var avatar = new AvatarUtilizadorViewModel
    {
        Nome = Model.Utilizador.Nome,
        FotoPerfil = Model.Utilizador.FotoPerfil,
        Tamanho = 130
    };
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger">
        @mensagemErro
    </div>
}

<div class="card user-profile-card mb-5">
    <div class="card-body p-4 p-md-5">
        <div class="row align-items-center">

            <div class="col-md-auto text-center mb-3 mb-md-0">
                <div class="d-flex justify-content-center">
                    <partial name="_UserAvatar"
                             model="avatar" />
                </div>
            </div>

            <div class="col-md">
                <p class="section-kicker mb-1">
                    PERFIL
                </p>
                <h1 class="section-title mb-2">
                    @Model.Utilizador.Nome
                </h1>

                <p class="text-muted mb-2">
                    Membro desde
                    @Model.Utilizador.CriadoEm.ToString("dd/MM/yyyy")
                </p>

                @if (Model.PerfilProprio)
                {
                    <span class="perfil-status perfil-proprio">
                        Este é o teu perfil
                    </span>
                }

                @if (!Model.PerfilProprio)
                {
                    <div class="mt-3">
                        @if (Model.SaoAmigos)
                        {
                            <span class="perfil-status amizade-aceite">
                                Amigos
                            </span>
                        }
                        else if (Model.PedidoEnviado)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="perfil-status amizade-pendente">
                                    Pedido enviado
                                </span>

                                <form method="post"
                                      asp-page-handler="CancelarPedido"
                                      asp-route-id="@Model.Utilizador.Id">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Cancelar pedido
                                    </button>
                                </form>
                            </div>
                        }
                        else if (Model.PedidoRecebido)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="perfil-status amizade-recebida">
                                    Este utilizador enviou-te um pedido de amizade
                                </span>

                                <a asp-page="/Friends/Index"
                                   class="btn btn-sm btn-primary">
                                    Gerir pedido
                                </a>
                            </div>
                        }
                        else
                        {
                            <form method="post"
                                  asp-page-handler="EnviarPedido"
                                  asp-route-id="@Model.Utilizador.Id">

                                <button type="submit"
                                        class="btn btn-primary">
                                    Enviar pedido de amizade
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<div class="meus-eventos-section-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            EVENTOS
        </p>

        <h2 class="h4 fw-bold mb-0">
            Eventos públicos criados
        </h2>
    </div>

    <span class="resultados-count">
        @Model.EventosPublicos.Count
        @(Model.EventosPublicos.Count == 1 ? "evento" : "eventos")
    </span>
</div>

@if (Model.EventosPublicos.Count == 0)
{
    <div class="eventos-empty-state mb-4">
        <h3 class="h5 fw-bold mb-2">
            Ainda não há eventos públicos
        </h3>

        <p class="text-muted mb-0">
            Este utilizador ainda não criou eventos públicos.
        </p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var evento in Model.EventosPublicos)
        {
            int numeroParticipantes =
                evento.Participantes.Count(
                    p => p.Estado == EstadoPedido.Aceite);

            <div class="col-md-6 col-lg-4">
                <div class="card evento-list-card h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="h5 fw-bold mb-2">
                            @evento.Titulo
                        </h5>

                        <p class="evento-card-descricao text-muted">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @evento.DataHora.ToString(
                                "dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-2">
                            <strong>Participantes:</strong>
                            @numeroParticipantes /
                            @evento.NumMaxParticipantes
                        </p>

                        <div class="mb-3">
                            @foreach (var eventoCategoria in
                                evento.EventosCategorias
                                    .OrderBy(
                                        ec => ec.Categoria.Nome))
                            {
                                <span class="categoria-badge mb-1">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <a asp-page="/Eventos/Details"
                           asp-route-id="@evento.Id"
                           class="btn btn-primary w-100 mt-auto">
                            Ver evento
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<a asp-page="./Index"
   class="btn btn-outline-secondary mt-4">
    Voltar aos utilizadores
</a>