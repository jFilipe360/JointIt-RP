@page
@using JoinIt.Web.Enums
@using JoinIt.Web.ViewModels
@model JoinIt.Web.Pages.Users.DetailsModel

@{
    ViewData["Title"] = "Perfil";

    var avatar = new AvatarUtilizadorViewModel
    {
        Nome = Model.Utilizador.Nome,
        FotoPerfil = Model.Utilizador.FotoPerfil,
        Tamanho = 130
    };
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger">
        @mensagemErro
    </div>
}

<div class="card shadow-sm mb-5">
    <div class="card-body">
        <div class="row align-items-center">

            <div class="col-md-auto text-center mb-3 mb-md-0">
                <div class="d-flex justify-content-center">
                    <partial name="_UserAvatar"
                             model="avatar" />
                </div>
            </div>

            <div class="col-md">
                <h1 class="mb-2">
                    @Model.Utilizador.Nome
                </h1>

                <p class="text-muted mb-2">
                    Membro desde
                    @Model.Utilizador.CriadoEm.ToString("dd/MM/yyyy")
                </p>

                @if (Model.PerfilProprio)
                {
                    <span class="badge bg-primary">
                        Este é o teu perfil
                    </span>
                }

                @if (!Model.PerfilProprio)
                {
                    <div class="mt-3">
                        @if (Model.SaoAmigos)
                        {
                            <span class="badge bg-success p-2">
                                Amigos
                            </span>
                        }
                        else if (Model.PedidoEnviado)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-warning text-dark p-2">
                                    Pedido enviado
                                </span>

                                <form method="post"
                                      asp-page-handler="CancelarPedido"
                                      asp-route-id="@Model.Utilizador.Id">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Cancelar pedido
                                    </button>
                                </form>
                            </div>
                        }
                        else if (Model.PedidoRecebido)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-info text-dark p-2">
                                    Este utilizador enviou-te um pedido de amizade
                                </span>

                                <a asp-page="/Friends/Index"
                                   class="btn btn-sm btn-primary">
                                    Gerir pedido
                                </a>
                            </div>
                        }
                        else
                        {
                            <form method="post"
                                  asp-page-handler="EnviarPedido"
                                  asp-route-id="@Model.Utilizador.Id">

                                <button type="submit"
                                        class="btn btn-primary">
                                    Enviar pedido de amizade
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<h2 class="mb-3">Eventos públicos criados</h2>

@if (Model.EventosPublicos.Count == 0)
{
    <div class="alert alert-info">
        Este utilizador ainda não criou eventos públicos.
    </div>
}
else
{
    <div class="row">
        @foreach (var evento in Model.EventosPublicos)
        {
            int numeroParticipantes =
                evento.Participantes.Count(
                    p => p.Estado == EstadoPedido.Aceite);

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            @evento.Titulo
                        </h5>

                        <p class="card-text">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @evento.DataHora.ToString(
                                "dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-2">
                            <strong>Participantes:</strong>
                            @numeroParticipantes /
                            @evento.NumMaxParticipantes
                        </p>

                        <div class="mb-3">
                            @foreach (var eventoCategoria in
                                evento.EventosCategorias
                                    .OrderBy(
                                        ec => ec.Categoria.Nome))
                            {
                                <span class="badge bg-secondary">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <a asp-page="/Eventos/Details"
                           asp-route-id="@evento.Id"
                           class="btn btn-outline-primary">
                            Ver evento
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<a asp-page="./Index"
   class="btn btn-secondary">
    Voltar aos utilizadores
</a>