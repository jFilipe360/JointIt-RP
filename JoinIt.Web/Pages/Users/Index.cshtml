@page
@model JoinIt.Web.Pages.Users.IndexModel
@using JoinIt.Web.ViewModels

@{
    ViewData["Title"] = "Utilizadores";
}

<div class="mb-4">
    <p class="section-kicker mb-1">
        COMUNIDADE
    </p>

    <h1 class="section-title mb-2">
        Utilizadores
    </h1>

    <p class="text-muted mb-0">
        Descobre outros utilizadores da plataforma.
    </p>
</div>

@if (Model.Utilizadores.Count == 0)
{
    <div class="eventos-empty-state">
        <h3 class="h5 fw-bold mb-2">
            Não existem outros utilizadores.
        </h3>

        <p class="text-muted mb-0">
            Quando novos utilizadores se registarem, vão aparecer aqui.
        </p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var utilizador in Model.Utilizadores)
        {
            var avatar = new AvatarUtilizadorViewModel
            {
                Nome = utilizador.Nome,
                FotoPerfil = utilizador.FotoPerfil,
                Tamanho = 90
            };

            <div class="col-md-6 col-lg-4">
                <div class="card user-card h-100">
                    <div class="card-body text-center p-4">

                        <div class="d-flex justify-content-center mb-3">
                            <partial name="_UserAvatar"
                                        model="avatar" />
                        </div>

                        <h2 class="h5 fw-bold mb-2">
                            @utilizador.Nome
                        </h2>

                        <p class="text-muted">
                            Membro desde
                            @utilizador.CriadoEm.ToString("dd/MM/yyyy")
                        </p>

                        <a asp-page="./Details"
                            asp-route-id="@utilizador.Id"
                            class="btn btn-primary w-100">
                            Ver perfil
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
}