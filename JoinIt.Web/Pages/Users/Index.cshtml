@page
@model JoinIt.Web.Pages.Users.IndexModel

@{
    ViewData["Title"] = "Utilizadores";
}

<div class="mb-4">
    <h1>Utilizadores</h1>

    <p class="text-muted">
        Descobre outros utilizadores da plataforma.
    </p>
</div>

@if (Model.Utilizadores.Count == 0)
{
    <div class="alert alert-info">
        Ainda não existem outros utilizadores.
    </div>
}
else
{
    <div class="row">
        @foreach (var utilizador in Model.Utilizadores)
        {
            string inicial = string.IsNullOrWhiteSpace(utilizador.Nome)
                ? "?"
                : utilizador.Nome.Substring(0, 1).ToUpper();

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">

                        @if (string.IsNullOrWhiteSpace(
                            utilizador.FotoPerfil))
                        {
                            <div class="rounded-circle bg-secondary text-white
                                d-flex align-items-center justify-content-center
                                mx-auto mb-3"
                                 style="width: 90px; height: 90px;
                                font-size: 2rem;">

                                @inicial
                            </div>
                        }
                        else
                        {
                            <img src="@utilizador.FotoPerfil"
                                 alt="Foto de @utilizador.Nome"
                                 class="rounded-circle mb-3"
                                 style="width: 90px;
                            height: 90px;
                            object-fit: cover;" />
                        }

                        <h5 class="card-title">
                            @utilizador.Nome
                        </h5>

                        <p class="text-muted">
                            Membro desde
                            @utilizador.CriadoEm.ToString("dd/MM/yyyy")
                        </p>

                        <a asp-page="./Details"
                           asp-route-id="@utilizador.Id"
                           class="btn btn-outline-primary">
                            Ver perfil
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
}