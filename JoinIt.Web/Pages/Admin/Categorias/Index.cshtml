@page
@model JoinIt.Web.Pages.Admin.Categorias.IndexModel

@{
    ViewData["Title"] = "Gerir categorias";
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger">
        @mensagemErro
    </div>
}

<div class="eventos-page-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            ADMINISTRAÇÃO
        </p>

        <h1 class="section-title mb-2">
            Categorias
        </h1>

        <p class="text-muted mb-0">
            Consulta e gere as categorias disponíveis nos eventos.
        </p>
    </div>

    <a asp-page="/Admin/Index"
       class="btn btn-outline-secondary">
        Voltar ao painel
    </a>
</div>

<div class="d-flex justify-content-between
            align-items-center mb-3">

    <h2 class="h5 fw-bold mb-0">
        Categorias registadas
    </h2>

    <div class="d-flex align-items-center gap-3">
        <span class="resultados-count">
            @Model.Categorias.Count
            @(Model.Categorias.Count == 1
                ? "categoria"
                : "categorias")
        </span>

        <a asp-page="./Create"
           class="btn btn-primary">
            Nova categoria
        </a>
    </div>
</div>

@if (Model.Categorias.Count == 0)
{
    <div class="eventos-empty-state">
        <h3 class="h5 fw-bold">
            Nenhuma categoria encontrada
        </h3>

        <p class="text-muted mb-0">
            Ainda não existem categorias registadas.
        </p>
    </div>
}
else
{
    <div class="card evento-details-card">
        <div class="table-responsive">

            <table class="table align-middle mb-0 admin-table">
                <thead>
                    <tr>
                        <th>Categoria</th>

                        <th class="text-end">
                            Ações
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    @categoria.Nome
                                </div>
                            </td>

                            <td class="text-end">
                                <div class="d-flex flex-wrap
                                            justify-content-end gap-2">

                                    <a asp-page="./Edit"
                                       asp-route-id="@categoria.Id"
                                       class="btn btn-sm
                                              btn-outline-secondary">
                                        Editar
                                    </a>

                                    <a asp-page="./Delete"
                                       asp-route-id="@categoria.Id"
                                       class="btn btn-sm
                                              btn-outline-danger">
                                        Apagar
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
}