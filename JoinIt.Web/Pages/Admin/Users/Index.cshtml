@page
@model JoinIt.Web.Pages.Admin.Users.IndexModel

@{
    ViewData["Title"] = "Gerir utilizadores";

    string? utilizadorAtualId =
        User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier
        )?.Value;
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger">
        @mensagemErro
    </div>
}

<div class="eventos-page-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            ADMINISTRAÇÃO
        </p>

        <h1 class="section-title mb-2">
            Utilizadores
        </h1>

        <p class="text-muted mb-0">
            Consulta os utilizadores registados e gere administradores.
        </p>
    </div>

    <a asp-page="/Admin/Index"
       class="btn btn-outline-secondary">
        Voltar ao painel
    </a>
</div>

<div class="card filtros-card mb-4">
    <div class="card-body p-4">
        <form method="get">
            <div class="row align-items-end">
                <div class="col-md-9 mb-3 mb-md-0">
                    <label asp-for="Pesquisa"
                           class="form-label">
                        Pesquisa
                    </label>

                    <input asp-for="Pesquisa"
                           class="form-control"
                           placeholder="Nome ou email..." />
                </div>

                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Pesquisar
                        </button>

                        <a asp-page="./Index"
                           class="btn btn-outline-secondary">
                            Limpar
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 fw-bold mb-0">
        Utilizadores registados
    </h2>

    <span class="resultados-count">
        @Model.Utilizadores.Count
        @(Model.Utilizadores.Count == 1
            ? "utilizador"
            : "utilizadores")
    </span>
</div>

@if (Model.Utilizadores.Count == 0)
{
    <div class="eventos-empty-state">
        <h3 class="h5 fw-bold">
            Nenhum utilizador encontrado
        </h3>

        <p class="text-muted mb-0">
            Não existem utilizadores que correspondam à pesquisa.
        </p>
    </div>
}
else
{
    <div class="card evento-details-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 admin-table">
                <thead>
                    <tr>
                        <th>Utilizador</th>
                        <th>Email</th>
                        <th>Registado em</th>
                        <th>Role</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var utilizador in Model.Utilizadores)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    <partial name="_UserAvatar"
                                             model="new JoinIt.Web.ViewModels.AvatarUtilizadorViewModel
                                             {
                                                 Nome = utilizador.Nome,
                                                 FotoPerfil = utilizador.FotoPerfil,
                                                 Tamanho = 42
                                             }" />

                                    <div>
                                        <a asp-page="/Users/Details"
                                           asp-route-id="@utilizador.Id"
                                           class="fw-semibold text-decoration-none">
                                            @utilizador.Nome
                                        </a>

                                        @if (utilizador.Id == utilizadorAtualId)
                                        {
                                            <div class="small text-muted">
                                                Tu
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>
                                @utilizador.Email
                            </td>

                            <td>
                                @utilizador.CriadoEm.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @if (utilizador.IsAdmin)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Utilizador
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                @if (utilizador.IsAdmin)
                                {
                                    @if (utilizador.Id != utilizadorAtualId)
                                    {
                                        <form method="post"
                                              asp-page-handler="RemoverAdmin"
                                              asp-route-id="@utilizador.Id"
                                              class="d-inline"
                                              onsubmit="return confirm('Remover os privilégios de administrador deste utilizador?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Remover Admin
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <form method="post"
                                          asp-page-handler="TornarAdmin"
                                          asp-route-id="@utilizador.Id"
                                          class="d-inline"
                                          onsubmit="return confirm('Tornar este utilizador administrador?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary">
                                            Tornar Admin
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}