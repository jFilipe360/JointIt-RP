@page
@model JoinIt.Web.Pages.Admin.IndexModel

@{
    ViewData["Title"] = "Administração";
}

<div class="eventos-page-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            ADMINISTRAÇÃO
        </p>

        <h1 class="section-title mb-2">
            Painel de administração
        </h1>

        <p class="text-muted mb-0">
            Gere utilizadores e eventos da plataforma.
        </p>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6 col-xl-3">
        <div class="card evento-details-card h-100">
            <div class="card-body p-4">
                <p class="text-muted mb-1">
                    Utilizadores
                </p>

                <h2 class="fw-bold mb-0">
                    @Model.TotalUtilizadores
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card evento-details-card h-100">
            <div class="card-body p-4">
                <p class="text-muted mb-1">
                    Eventos
                </p>

                <h2 class="fw-bold mb-0">
                    @Model.TotalEventos
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card evento-details-card h-100">
            <div class="card-body p-4">
                <p class="text-muted mb-1">
                    Eventos ativos
                </p>

                <h2 class="fw-bold mb-0">
                    @Model.EventosAtivos
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card evento-details-card h-100">
            <div class="card-body p-4">
                <p class="text-muted mb-1">
                    Participações
                </p>

                <h2 class="fw-bold mb-0">
                    @Model.TotalParticipacoes
                </h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card evento-details-card h-100">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold">
                    Utilizadores
                </h2>

                <p class="text-muted">
                    Consulta e gere os utilizadores registados.
                </p>

                <a asp-page="/Admin/Users/Index"
                   class="btn btn-primary">
                    Gerir utilizadores
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card evento-details-card h-100">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold">
                    Eventos
                </h2>

                <p class="text-muted">
                    Consulta todos os eventos da plataforma.
                </p>

                <a asp-page="/Admin/Eventos/Index"
                   class="btn btn-primary">
                    Gerir eventos
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card evento-details-card h-100">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold">
                    Categorias
                </h2>

                <p class="text-muted">
                    Consulta e gere as categorias dos eventos.
                </p>

                <a asp-page="/Admin/Categorias/Index"
                   class="btn btn-primary">
                    Gerir categorias
                </a>
            </div>
        </div>
    </div>
</div>