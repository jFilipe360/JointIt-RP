@page
@model JoinIt.Web.Pages.Notifications.IndexModel

@{
    ViewData["Title"] = "Notificações";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>Notificações</h1>

        <p class="text-muted mb-0">
            Tens @Model.NumeroNaoLidas notificações não lidas.
        </p>
    </div>

    @if (Model.NumeroNaoLidas > 0)
    {
        <form method="post"
              asp-page-handler="MarcarTodas">

            <button type="submit"
                    class="btn btn-outline-primary">
                Marcar todas como lidas
            </button>
        </form>
    }
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (Model.Notificacoes.Count == 0)
{
    <div class="alert alert-info">
        Ainda não tens notificações.
    </div>
}
else
{
    <div class="list-group">
        @foreach (var notificacao in Model.Notificacoes)
        {
            string classeNotificacao = notificacao.Lida
                ? "list-group-item-light"
                : "list-group-item-primary";

            <div class="list-group-item @classeNotificacao mb-3 rounded shadow-sm">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h5 class="mb-0">
                                @notificacao.Titulo
                            </h5>

                            @if (!notificacao.Lida)
                            {
                                <span class="badge bg-primary">
                                    Nova
                                </span>
                            }
                        </div>

                        <p class="mb-2">
                            @notificacao.Mensagem
                        </p>

                        <small class="text-muted">
                            @notificacao.CriadoEm.ToString(
                                "dd/MM/yyyy HH:mm")
                        </small>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        @if (!string.IsNullOrWhiteSpace(
                            notificacao.Link))
                        {
                            <form method="post"
                                  asp-page-handler="Abrir"
                                  asp-route-id="@notificacao.Id">

                                <button type="submit"
                                        class="btn btn-sm btn-primary w-100">
                                    Abrir
                                </button>
                            </form>
                        }

                        @if (!notificacao.Lida)
                        {
                            <form method="post"
                                  asp-page-handler="MarcarLida"
                                  asp-route-id="@notificacao.Id">

                                <button type="submit"
                                        class="btn btn-sm btn-outline-secondary w-100">
                                    Marcar como lida
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}