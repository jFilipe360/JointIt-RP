@page
@model JoinIt.Web.Pages.Notifications.IndexModel

@{
    ViewData["Title"] = "Notificações";
}

<div class="notifications-page-header mb-5">
    <div>
        <p class="section-kicker mb-1">
            ATIVIDADE
        </p>
        <h1 class="section-title mb-2">
            Notificações
        </h1>

        <p class="text-muted mb-0">
            @if (Model.NumeroNaoLidas == 0)
            {
                <text>Não tens notificações por ler.</text>
            }
            else
            {
                <text>
                    Tens @Model.NumeroNaoLidas
                    @(Model.NumeroNaoLidas == 1
                        ? "notificação não lida"
                        : "notificações não lidas").
                </text>
            }
        </p>
    </div>

    @if (Model.NumeroNaoLidas > 0)
    {
        <form method="post"
              asp-page-handler="MarcarTodas">

            <button type="submit"
                    class="btn btn-primary px-4">
                Marcar todas como lidas
            </button>
        </form>
    }
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (Model.Notificacoes.Count == 0)
{
    <div class="eventos-empty-state">
        <h3 class="h5 fw-bold mb-2">
            Ainda não tens notificações
        </h3>

        <p class="text-muted mb-0">
            Quando houver atividade relacionada contigo,
            as notificações vão aparecer aqui.
        </p>
    </div>
}
else
{
    <div class="notifications-list">
        @foreach (var notificacao in Model.Notificacoes)
        {
            string classeNotificacao = notificacao.Lida
                ? "notificacao-lida"
                : "notificacao-nao-lida";

            <div class="notificacao-item @classeNotificacao mb-3">
                <div class="notificacao-conteudo">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h3 class="notificacao-titulo mb-0">
                                @notificacao.Titulo
                            </h3>

                            @if (!notificacao.Lida)
                            {
                                <span class="notificacao-nova-badge">
                                    Nova
                                </span>
                            }
                        </div>

                        <p class="notificacao-mensagem mb-2">
                            @notificacao.Mensagem
                        </p>

                        <small class="notificacao-data">
                            @notificacao.CriadoEm.ToString(
                                "dd/MM/yyyy HH:mm")
                        </small>
                    </div>

                    <div class="notificacao-actions">
                        @if (!string.IsNullOrWhiteSpace(
                            notificacao.Link))
                        {
                            <form method="post"
                                  asp-page-handler="Abrir"
                                  asp-route-id="@notificacao.Id">

                                <button type="submit"
                                        class="btn btn-sm btn-primary">
                                    Abrir
                                </button>
                            </form>
                        }

                        @if (!notificacao.Lida)
                        {
                            <form method="post"
                                  asp-page-handler="MarcarLida"
                                  asp-route-id="@notificacao.Id">

                                <button type="submit"
                                        class="btn btn-sm btn-outline-secondary">
                                    Marcar como lida
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}