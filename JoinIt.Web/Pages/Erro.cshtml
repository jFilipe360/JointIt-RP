@page "/Erro/{codigo:int}"
@model JoinIt.Web.Pages.ErroModel

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card evento-details-card">
            <div class="card-body p-4 p-md-5 text-center">
                <p class="section-kicker mb-1">
                    ERRO @Model.Codigo
                </p>

                @if (Model.Codigo == 403)
                {
                    <i class="bi bi-shield-lock fs-1 mb-3 d-block"></i>
                }
                else if (Model.Codigo == 404)
                {
                    <i class="bi bi-search fs-1 mb-3 d-block"></i>
                }
                else
                {
                    <i class="bi bi-exclamation-circle fs-1 mb-3 d-block"></i>
                }

                <h2 class="h5 fw-bold mb-3">
                    @Model.Titulo
                </h2>
                <p class="text-muted mb-4">
                    @Model.Mensagem
                </p>
                <a asp-page="/Index" class="btn btn-primary px-4">
                    Voltar à página inicial
                </a>
            </div>
        </div>
    </div>
</div>