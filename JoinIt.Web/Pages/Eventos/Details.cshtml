@page
@using JoinIt.Web.Enums
@using System.Globalization
@model JoinIt.Web.Pages.Eventos.DetailsModel

@{
    ViewData["Title"] = "Detalhes do evento";

    string estado = Model.Evento.Estado switch
    {
        EstadoEvento.ParaBreve => "Para breve",
        EstadoEvento.ADecorrer => "A decorrer",
        EstadoEvento.Terminado => "Terminado",
        EstadoEvento.Cancelado => "Cancelado",
        _ => Model.Evento.Estado.ToString()
    };

    string classeEstado = Model.Evento.Estado switch
    {
        EstadoEvento.ParaBreve => "bg-primary",
        EstadoEvento.ADecorrer => "bg-success",
        EstadoEvento.Terminado => "bg-secondary",
        EstadoEvento.Cancelado => "bg-danger",
        _ => "bg-secondary"
    };

    string returnUrl =
        $"{ViewContext.HttpContext.Request.Path}" +
        $"{ViewContext.HttpContext.Request.QueryString}";

    bool temCoordenadas =
        Model.Evento.Latitude.HasValue &&
        Model.Evento.Longitude.HasValue;

    string? latitudeMapa = Model.Evento.Latitude?
        .ToString(CultureInfo.InvariantCulture);

    string? longitudeMapa = Model.Evento.Longitude?
        .ToString(CultureInfo.InvariantCulture);

    string? urlMapa = temCoordenadas
        ? $"https://www.openstreetmap.org/" +
          $"?mlat={latitudeMapa}&mlon={longitudeMapa}" +
          $"#map=16/{latitudeMapa}/{longitudeMapa}"
        : null;
}

@if (temCoordenadas)
{
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          crossorigin="" />
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger">
        @mensagemErro
    </div>
}

@if (Model.Evento.Estado == EstadoEvento.Cancelado)
{
    <div class="alert alert-danger">
        Este evento foi cancelado.
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>@Model.Evento.Titulo</h1>

        <p class="text-muted mb-0">
            Criado por

            <a asp-page="/Users/Details"
               asp-route-id="@Model.Evento.CriadorId">
                @Model.Evento.Criador.Nome
            </a>
        </p>
    </div>

    <div class="d-flex flex-column align-items-end gap-2">
        @if (Model.Evento.IsPrivado)
        {
            <span class="badge bg-warning text-dark fs-6">
                Privado
            </span>
        }
        else
        {
            <span class="badge bg-success fs-6">
                Público
            </span>
        }

        <span class="badge @classeEstado fs-6">
            @estado
        </span>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4 class="card-title">
                    Descrição
                </h4>

                <p class="card-text"
                   style="white-space: pre-line;">@Model.Evento.Descricao</p>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4 class="card-title">
                    Localização
                </h4>

                <p class="mb-1">
                    <strong>Local:</strong>
                    @Model.Evento.Local
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Evento.Morada))
                {
                    <p class="mb-3">
                        <strong>Morada:</strong>
                        @Model.Evento.Morada
                    </p>
                }

                @if (temCoordenadas)
                {
                    <div id="mapaEvento"
                         class="rounded border mb-3"
                         style="height: 380px;">
                    </div>

                    <a href="@urlMapa"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-sm btn-outline-primary">
                        Abrir no OpenStreetMap
                    </a>
                }
                else
                {
                    <p class="text-muted mb-0">
                        Este evento não tem uma localização exata selecionada
                        no mapa.
                    </p>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4 class="card-title">
                    Participantes
                </h4>

                <p>
                    @Model.NumeroParticipantes /
                    @Model.Evento.NumMaxParticipantes
                </p>

                @if (Model.NumeroParticipantes == 0)
                {
                    <p class="text-muted mb-0">
                        Ainda não existem participantes.
                    </p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var participante in
                            Model.Evento.Participantes
                                .Where(p =>
                                    p.Estado == EstadoPedido.Aceite)
                                .OrderBy(p =>
                                    p.Utilizador.Nome))
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex align-items-center gap-3">

                                    <partial name="_UserAvatar"
                                             model="new JoinIt.Web.ViewModels.AvatarUtilizadorViewModel
                                             {
                                                 Nome = participante.Utilizador.Nome,
                                                 FotoPerfil = participante.Utilizador.FotoPerfil,
                                                 Tamanho = 42
                                             }" />

                                    <div>
                                        <a asp-page="/Users/Details"
                                           asp-route-id="@participante.UtilizadorId"
                                           class="text-decoration-none">
                                            @participante.Utilizador.Nome
                                        </a>

                                        @if (participante.UtilizadorId ==
                                             Model.Evento.CriadorId)
                                        {
                                            <span class="badge bg-primary ms-2">
                                                Criador
                                            </span>
                                        }
                                    </div>

                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4 class="card-title">
                    Informações
                </h4>

                <dl class="row mb-0">
                    <dt class="col-sm-5">
                        Início
                    </dt>

                    <dd class="col-sm-7">
                        @Model.Evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-5">
                        Fim
                    </dt>

                    <dd class="col-sm-7">
                        @Model.Evento.DataFim.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-5">
                        Duração
                    </dt>

                    <dd class="col-sm-7">
                        @{
                            TimeSpan duracao =
                                Model.Evento.DataFim -
                                Model.Evento.DataHora;

                            if (duracao.TotalDays >= 1)
                            {
                                <span>
                                    @duracao.Days dia(s) e
                                    @duracao.Hours hora(s)
                                </span>
                            }
                            else
                            {
                                <span>
                                    @duracao.Hours hora(s) e
                                    @duracao.Minutes minuto(s)
                                </span>
                            }
                        }
                    </dd>

                    <dt class="col-sm-5">
                        Lotação
                    </dt>

                    <dd class="col-sm-7">
                        @Model.NumeroParticipantes /
                        @Model.Evento.NumMaxParticipantes
                    </dd>

                    <dt class="col-sm-5">
                        Estado
                    </dt>

                    <dd class="col-sm-7">
                        <span class="badge @classeEstado">
                            @estado
                        </span>
                    </dd>

                    <dt class="col-sm-5">
                        Local
                    </dt>

                    <dd class="col-sm-7">
                        @Model.Evento.Local
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4 class="card-title">
                    Categorias
                </h4>

                @foreach (var eventoCategoria in
                    Model.Evento.EventosCategorias
                        .OrderBy(ec => ec.Categoria.Nome))
                {
                    <span class="badge bg-secondary mb-1">
                        @eventoCategoria.Categoria.Nome
                    </span>
                }
            </div>
        </div>

    </div>
</div>

@if (Model.TemConvitePendente)
{
    <div class="alert alert-info">
        Tens um convite pendente para este evento.

        <a asp-page="/Convites/Index"
           class="alert-link">
            Responder ao convite
        </a>
    </div>
}

<div class="d-flex flex-wrap gap-2">
    <a asp-page="./Index"
       class="btn btn-secondary">
        Voltar aos eventos
    </a>

    @if (Model.PodeGerir || Model.EstaAParticipar)
    {
        <a asp-page="./Chat"
           asp-route-id="@Model.Evento.Id"
           class="btn btn-info">
            Abrir chat
        </a>
    }

    @if (Model.PodeGerir)
    {
        @if (Model.Evento.Estado != EstadoEvento.Cancelado &&
             Model.Evento.Estado != EstadoEvento.Terminado)
        {
            @if (Model.Evento.IsPrivado &&
                 Model.Evento.Estado == EstadoEvento.ParaBreve)
            {
                <a asp-page="./Invite"
                   asp-route-id="@Model.Evento.Id"
                   class="btn btn-success">
                    Convidar amigos
                </a>
            }

            <a asp-page="./Edit"
               asp-route-id="@Model.Evento.Id"
               class="btn btn-primary">
                Editar evento
            </a>

            <form method="post"
                  asp-page-handler="Cancelar"
                  asp-route-id="@Model.Evento.Id"
                  onsubmit="return confirm('Tens a certeza de que pretendes cancelar este evento?');">

                <button type="submit"
                        class="btn btn-warning">
                    Cancelar evento
                </button>
            </form>
        }

        <a asp-page="./Delete"
           asp-route-id="@Model.Evento.Id"
           class="btn btn-danger">
            Apagar evento
        </a>
    }
    else if (Model.EstaAParticipar)
    {
        <form method="post"
              asp-page-handler="Sair"
              asp-route-id="@Model.Evento.Id">

            <button type="submit"
                    class="btn btn-outline-danger">
                Sair do evento
            </button>
        </form>
    }
    else if (Model.PodeParticipar)
    {
        <form method="post"
              asp-page-handler="Participar"
              asp-route-id="@Model.Evento.Id">

            <button type="submit"
                    class="btn btn-success">
                Participar
            </button>
        </form>
    }
    else if (Model.EventoCheio)
    {
        <span class="badge bg-danger align-self-center p-2">
            Evento cheio
        </span>
    }
    else if (User.Identity?.IsAuthenticated != true &&
             !Model.Evento.IsPrivado)
    {
        <a asp-area="Identity"
           asp-page="/Account/Login"
           asp-route-returnUrl="@returnUrl"
           class="btn btn-outline-primary">
            Iniciar sessão para participar
        </a>
    }
</div>

@section Scripts {
    @if (temCoordenadas)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                crossorigin="">
        </script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const latitudeEvento = @latitudeMapa;
                const longitudeEvento = @longitudeMapa;

                const mapa = L.map("mapaEvento").setView(
                    [latitudeEvento, longitudeEvento],
                    16
                );

                L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                    {
                        maxZoom: 19,
                        attribution:
                            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                    }
                ).addTo(mapa);

                L.marker(
                    [latitudeEvento, longitudeEvento]
                ).addTo(mapa);
            });
        </script>
    }
}