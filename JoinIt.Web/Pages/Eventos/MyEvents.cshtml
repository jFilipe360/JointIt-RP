@page
@using JoinIt.Web.Enums
@model JoinIt.Web.Pages.Eventos.MyEventsModel

@{
    ViewData["Title"] = "Os meus eventos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Os meus eventos</h1>

        <p class="text-muted mb-0">
            Consulta os eventos que criaste e aqueles em que participas.
        </p>
    </div>

    <a asp-page="./Create"
       class="btn btn-primary">
        Criar evento
    </a>
</div>

<h2 class="mb-3">Eventos criados por mim</h2>

@if (Model.EventosCriados.Count == 0)
{
    <div class="alert alert-info">
        Ainda não criaste nenhum evento.
    </div>
}
else
{
    <div class="row mb-5">
        @foreach (var evento in Model.EventosCriados)
        {
            int participantes = evento.Participantes.Count(
                p => p.Estado == EstadoPedido.Aceite);

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2">
                            <h5 class="card-title">
                                @evento.Titulo
                            </h5>

                            @if (evento.IsPrivado)
                            {
                                <span class="badge bg-warning text-dark">
                                    Privado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Público
                                </span>
                            }
                        </div>

                        <p class="card-text">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-2">
                            <strong>Participantes:</strong>
                            @participantes /
                            @evento.NumMaxParticipantes
                        </p>

                        <div class="mb-3">
                            @foreach (var eventoCategoria in
                                evento.EventosCategorias
                                    .OrderBy(ec => ec.Categoria.Nome))
                            {
                                <span class="badge bg-secondary">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-page="./Details"
                               asp-route-id="@evento.Id"
                               class="btn btn-outline-primary">
                                Ver detalhes
                            </a>

                            <a asp-page="./Edit"
                               asp-route-id="@evento.Id"
                               class="btn btn-outline-secondary">
                                Editar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h2 class="mb-3">Eventos em que participo</h2>

@if (Model.EventosParticipados.Count == 0)
{
    <div class="alert alert-info">
        Ainda não estás a participar em nenhum evento.
    </div>
}
else
{
    <div class="row">
        @foreach (var evento in Model.EventosParticipados)
        {
            int participantes = evento.Participantes.Count(
                p => p.Estado == EstadoPedido.Aceite);

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            @evento.Titulo
                        </h5>

                        <p class="card-text">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Criador:</strong>
                            @evento.Criador.Nome
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-2">
                            <strong>Participantes:</strong>
                            @participantes /
                            @evento.NumMaxParticipantes
                        </p>

                        <div class="mb-3">
                            @foreach (var eventoCategoria in
                                evento.EventosCategorias
                                    .OrderBy(ec => ec.Categoria.Nome))
                            {
                                <span class="badge bg-secondary">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <a asp-page="./Details"
                           asp-route-id="@evento.Id"
                           class="btn btn-outline-primary">
                            Ver detalhes
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}