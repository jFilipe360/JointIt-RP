@page
@using JoinIt.Web.Enums
@model JoinIt.Web.Pages.Eventos.MyEventsModel

@{
    ViewData["Title"] = "Os meus eventos";
}

<div class="eventos-page-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            A TUA ATIVIDADE
        </p>
        <h1 class="section-title mb-2">
            Os meus eventos
        </h1>

        <p class="text-muted mb-0">
            Consulta os eventos que criaste e aqueles em que participas.
        </p>
    </div>

    <a asp-page="./Create"
       class="btn btn-primary px-4">
        Criar evento
    </a>
</div>

<div class="card meus-eventos-filtros mb-5">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap gap-2 meus-eventos-filter-buttons">

            <a asp-page="./MyEvents"
               asp-route-filtro="ativos"
               class="btn @(Model.Filtro == "ativos"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Ativos
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="futuros"
               class="btn @(Model.Filtro == "futuros"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Futuros
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="decorrer"
               class="btn @(Model.Filtro == "decorrer"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                A decorrer
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="terminados"
               class="btn @(Model.Filtro == "terminados"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Terminados
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="cancelados"
               class="btn @(Model.Filtro == "cancelados"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Cancelados
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="todos"
               class="btn @(Model.Filtro == "todos"
                   ? "btn-secondary"
                   : "btn-outline-secondary")">
                Todos
            </a>

        </div>
    </div>
</div>

<div class="meus-eventos-section-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            ORGANIZADOS POR TI
        </p>

        <h2 class="h4 fw-bold mb-0">
            Eventos criados por mim
        </h2>
    </div>

    <span class="resultados-count">
        @Model.EventosCriados.Count
        @(Model.EventosCriados.Count == 1 ? "evento" : "eventos")
    </span>
</div>

@if (Model.EventosCriados.Count == 0)
{
    <div class="eventos-empty-state mb-5">
        <h3 class="h5 fw-bold mb-2">
            Ainda não tens eventos nesta categoria
        </h3>

        <p class="text-muted mb-0">
            Não existem eventos criados por ti neste filtro.
        </p>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        @foreach (var evento in Model.EventosCriados)
        {
            int participantes = evento.Participantes.Count(
                p => p.Estado == EstadoPedido.Aceite);

            int lugaresDisponiveis = Math.Max(
                0,
                evento.NumMaxParticipantes - participantes);

            string nomeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "Para breve",
                EstadoEvento.ADecorrer => "A decorrer",
                EstadoEvento.Terminado => "Terminado",
                EstadoEvento.Cancelado => "Cancelado",
                _ => evento.Estado.ToString()
            };

            string classeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "estado-parabreve",
                EstadoEvento.ADecorrer => "estado-decorrer",
                EstadoEvento.Terminado => "estado-terminado",
                EstadoEvento.Cancelado => "estado-cancelado",
                _ => "estado-terminado"
            };

            <div class="col-md-6 col-lg-4">
                <div class="card evento-list-card h-100">
                    <div class="card-body d-flex flex-column p-4">

                        <div class="d-flex justify-content-between
                                    align-items-start gap-2 mb-2">

                            <h5 class="card-title mb-0">
                                @evento.Titulo
                            </h5>

                            <span class="estado-badge @classeEstado">
                                @nomeEstado
                            </span>
                        </div>

                        <div class="mb-3">
                            @if (evento.IsPrivado)
                            {
                                <span class="privacidade-badge privacidade-privado">
                                    Privado
                                </span>
                            }
                            else
                            {
                                <span class="privacidade-badge privacidade-publico">
                                    Público
                                </span>
                            }
                        </div>

                        <p class="evento-card-descricao text-muted">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Início:</strong>
                            @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Fim:</strong>
                            @evento.DataFim.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Local:</strong>
                            @evento.Local
                        </p>

                        <p class="mb-1">
                            <strong>Participantes:</strong>
                            @participantes /
                            @evento.NumMaxParticipantes
                        </p>

                        @if (lugaresDisponiveis == 0)
                        {
                            <span class="evento-lotacao evento-lotado mb-3">
                                Lotação máxima atingida
                            </span>
                        }
                        else
                        {
                            <span class="evento-lotacao evento-disponivel mb-3">
                                @lugaresDisponiveis
                                @(lugaresDisponiveis == 1
                                    ? "lugar disponível"
                                    : "lugares disponíveis")
                            </span>
                        }

                        <div class="mb-3">
                            @foreach (var eventoCategoria in
                                evento.EventosCategorias
                                    .OrderBy(ec => ec.Categoria.Nome))
                            {
                                <span class="categoria-badge mb-1">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a asp-page="./Details"
                               asp-route-id="@evento.Id"
                               class="btn btn-primary">
                                Ver detalhes
                            </a>

                            @if (evento.Estado != EstadoEvento.Terminado &&
                                 evento.Estado != EstadoEvento.Cancelado)
                            {
                                <a asp-page="./Edit"
                                   asp-route-id="@evento.Id"
                                   class="btn btn-outline-secondary">
                                    Editar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="meus-eventos-section-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            PARTICIPAÇÕES
        </p>

        <h2 class="h4 fw-bold mb-0">
            Eventos em que participo
        </h2>
    </div>

    <span class="resultados-count">
        @Model.EventosParticipados.Count
        @(Model.EventosParticipados.Count == 1 ? "evento" : "eventos")
    </span>
</div>

