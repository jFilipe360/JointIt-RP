@page
@using JoinIt.Web.Enums
@model JoinIt.Web.Pages.Eventos.MyEventsModel

@{
    ViewData["Title"] = "Os meus eventos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Os meus eventos</h1>

        <p class="text-muted mb-0">
            Consulta os eventos que criaste e aqueles em que participas.
        </p>
    </div>

    <a asp-page="./Create"
       class="btn btn-primary">
        Criar evento
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">

            <a asp-page="./MyEvents"
               asp-route-filtro="ativos"
               class="btn @(Model.Filtro == "ativos"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Ativos
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="futuros"
               class="btn @(Model.Filtro == "futuros"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Futuros
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="decorrer"
               class="btn @(Model.Filtro == "decorrer"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                A decorrer
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="terminados"
               class="btn @(Model.Filtro == "terminados"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Terminados
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="cancelados"
               class="btn @(Model.Filtro == "cancelados"
                   ? "btn-primary"
                   : "btn-outline-primary")">
                Cancelados
            </a>

            <a asp-page="./MyEvents"
               asp-route-filtro="todos"
               class="btn @(Model.Filtro == "todos"
                   ? "btn-secondary"
                   : "btn-outline-secondary")">
                Todos
            </a>

        </div>
    </div>
</div>

<h2 class="mb-3">
    Eventos criados por mim
</h2>

@if (Model.EventosCriados.Count == 0)
{
    <div class="alert alert-info">
        Não existem eventos criados por ti neste filtro.
    </div>
}
else
{
    <div class="row mb-5">
        @foreach (var evento in Model.EventosCriados)
        {
            int participantes = evento.Participantes.Count(
                p => p.Estado == EstadoPedido.Aceite);

            int lugaresDisponiveis = Math.Max(
                0,
                evento.NumMaxParticipantes - participantes);

            string nomeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "Para breve",
                EstadoEvento.ADecorrer => "A decorrer",
                EstadoEvento.Terminado => "Terminado",
                EstadoEvento.Cancelado => "Cancelado",
                _ => evento.Estado.ToString()
            };

            string classeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "bg-primary",
                EstadoEvento.ADecorrer => "bg-success",
                EstadoEvento.Terminado => "bg-secondary",
                EstadoEvento.Cancelado => "bg-danger",
                _ => "bg-secondary"
            };

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between
                                    align-items-start gap-2 mb-2">

                            <h5 class="card-title mb-0">
                                @evento.Titulo
                            </h5>

                            <span class="badge @classeEstado">
                                @nomeEstado
                            </span>
                        </div>

                        <div class="mb-3">
                            @if (evento.IsPrivado)
                            {
                                <span class="badge bg-warning text-dark">
                                    Privado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Público
                                </span>
                            }
                        </div>

                        <p class="card-text text-muted"
                           style="display: -webkit-box;
                                  -webkit-line-clamp: 3;
                                  -webkit-box-orient: vertical;
                                  overflow: hidden;">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Início:</strong>
                            @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Fim:</strong>
                            @evento.DataFim.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Local:</strong>
                            @evento.Local
                        </p>

                        <p class="mb-1">
                            <strong>Participantes:</strong>
                            @participantes /
                            @evento.NumMaxParticipantes
                        </p>

                        @if (lugaresDisponiveis == 0)
                        {
                            <span class="badge bg-danger align-self-start mb-3">
                                Lotado
                            </span>
                        }
                        else
                        {
                            <span class="text-success small mb-3">
                                @lugaresDisponiveis
                                @(lugaresDisponiveis == 1
                                    ? "lugar disponível"
                                    : "lugares disponíveis")
                            </span>
                        }

                        <div class="mb-3">
                            @foreach (var eventoCategoria in
                                evento.EventosCategorias
                                    .OrderBy(ec => ec.Categoria.Nome))
                            {
                                <span class="badge bg-secondary mb-1">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a asp-page="./Details"
                               asp-route-id="@evento.Id"
                               class="btn btn-outline-primary">
                                Ver detalhes
                            </a>

                            @if (evento.Estado != EstadoEvento.Terminado &&
                                 evento.Estado != EstadoEvento.Cancelado)
                            {
                                <a asp-page="./Edit"
                                   asp-route-id="@evento.Id"
                                   class="btn btn-outline-secondary">
                                    Editar
                                </a>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

