@page
@using JoinIt.Web.Enums
@model JoinIt.Web.Pages.Eventos.IndexModel

@{
    ViewData["Title"] = "Eventos";
}

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Eventos</h1>

        <p class="text-muted mb-0">
            Descobre eventos públicos por data, local ou categoria.
        </p>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="./Create"
           class="btn btn-primary">
            Criar evento
        </a>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <form method="get"
              asp-page="./Index">

            <div class="row">
                <div class="col-lg-4 mb-3">
                    <label asp-for="Pesquisa"
                           class="form-label">
                        Pesquisa
                    </label>

                    <input asp-for="Pesquisa"
                           class="form-control"
                           placeholder="Título, local ou categoria..." />
                </div>

                <div class="col-lg-4 mb-3">
                    <label asp-for="CategoriaId"
                           class="form-label">
                        Categoria
                    </label>

                    <select asp-for="CategoriaId"
                            asp-items="Model.Categorias"
                            class="form-select">

                        <option value="">
                            Todas as categorias
                        </option>
                    </select>
                </div>

                <div class="col-lg-4 mb-3">
                    <label asp-for="Estado"
                           class="form-label">
                        Estado
                    </label>

                    <select asp-for="Estado"
                            class="form-select">

                        <option value="">
                            Todos os estados
                        </option>

                        <option value="@EstadoEvento.ParaBreve">
                            Para breve
                        </option>

                        <option value="@EstadoEvento.ADecorrer">
                            A decorrer
                        </option>

                        <option value="@EstadoEvento.Terminado">
                            Terminado
                        </option>

                        <option value="@EstadoEvento.Cancelado">
                            Cancelado
                        </option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DataDe"
                           class="form-label">
                        Data inicial
                    </label>

                    <input asp-for="DataDe"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="DataAte"
                           class="form-label">
                        Data final
                    </label>

                    <input asp-for="DataAte"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Ordenacao"
                           class="form-label">
                        Ordenar por
                    </label>

                    <select asp-for="Ordenacao"
                            class="form-select">

                        <option value="data-asc">
                            Data mais próxima
                        </option>

                        <option value="data-desc">
                            Data mais distante
                        </option>

                        <option value="nome">
                            Nome
                        </option>

                        <option value="participantes-desc">
                            Mais participantes
                        </option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErroFiltros))
            {
                <div class="alert alert-danger">
                    @Model.ErroFiltros
                </div>
            }

            <div class="d-flex flex-wrap align-items-center gap-4 mb-3">
                <div class="form-check">
                    <input asp-for="ApenasFuturos"
                           class="form-check-input" />

                    <label asp-for="ApenasFuturos"
                           class="form-check-label">
                        Apenas eventos futuros
                    </label>
                </div>

                <div class="form-check">
                    <input asp-for="ComLugares"
                           class="form-check-input" />

                    <label asp-for="ComLugares"
                           class="form-check-label">
                        Apenas com lugares disponíveis
                    </label>
                </div>
            </div>

            <div class="form-text mb-3">
                Ao escolheres um estado específico, o filtro
                “Apenas eventos futuros” é ignorado.
            </div>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    Aplicar filtros
                </button>

                <a asp-page="./Index"
                   class="btn btn-outline-secondary">
                    Limpar
                </a>
            </div>

        </form>

    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">
        Resultados
    </h2>

    <span class="text-muted">
        @Model.Eventos.Count
        @(Model.Eventos.Count == 1 ? "evento" : "eventos")
    </span>
</div>

@if (Model.Eventos.Count == 0)
{
    <div class="alert alert-info">
        Não foram encontrados eventos com os filtros selecionados.
    </div>
}
else
{
    <div class="row">
        @foreach (var evento in Model.Eventos)
        {
            int numeroParticipantes =
                evento.Participantes.Count(p =>
                    p.Estado == EstadoPedido.Aceite);

            int lugaresDisponiveis = Math.Max(
                0,
                evento.NumMaxParticipantes - numeroParticipantes);

            bool eventoCheio = lugaresDisponiveis == 0;

            string nomeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "Para breve",
                EstadoEvento.ADecorrer => "A decorrer",
                EstadoEvento.Terminado => "Terminado",
                EstadoEvento.Cancelado => "Cancelado",
                _ => evento.Estado.ToString()
            };

            string classeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "bg-primary",
                EstadoEvento.ADecorrer => "bg-success",
                EstadoEvento.Terminado => "bg-secondary",
                EstadoEvento.Cancelado => "bg-danger",
                _ => "bg-secondary"
            };

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between
                                    align-items-start gap-2 mb-2">

                            <h5 class="card-title mb-0">
                                @evento.Titulo
                            </h5>

                            <span class="badge @classeEstado">
                                @nomeEstado
                            </span>
                        </div>

                        <p class="card-text text-muted"
                           style="display: -webkit-box;
                                  -webkit-line-clamp: 3;
                                  -webkit-box-orient: vertical;
                                  overflow: hidden;">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Início:</strong>
                            @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Fim:</strong>
                            @evento.DataFim.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Local:</strong>
                            @evento.Local
                        </p>

                        @if (!string.IsNullOrWhiteSpace(evento.Morada))
                        {
                            <p class="mb-1 text-muted small">
                                @evento.Morada
                            </p>
                        }

                        <p class="mb-1">
                            <strong>Criador:</strong>

                            <a asp-page="/Users/Details"
                               asp-route-id="@evento.CriadorId"
                               class="text-decoration-none">
                                @evento.Criador.Nome
                            </a>
                        </p>

                        <p class="mb-2">
                            <strong>Participantes:</strong>
                            @numeroParticipantes /
                            @evento.NumMaxParticipantes
                        </p>

                        @if (eventoCheio)
                        {
                            <span class="badge bg-danger align-self-start mb-2">
                                Lotado
                            </span>
                        }
                        else
                        {
                            <span class="text-success small mb-2">
                                @lugaresDisponiveis
                                @(lugaresDisponiveis == 1
                                    ? "lugar disponível"
                                    : "lugares disponíveis")
                            </span>
                        }

                        <div class="mb-3">
                            @foreach (var eventoCategoria in
                                evento.EventosCategorias
                                    .OrderBy(ec => ec.Categoria.Nome))
                            {
                                <span class="badge bg-secondary mb-1">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <div class="mt-auto">
                            <a asp-page="./Details"
                               asp-route-id="@evento.Id"
                               class="btn btn-outline-primary">
                                Ver detalhes
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}