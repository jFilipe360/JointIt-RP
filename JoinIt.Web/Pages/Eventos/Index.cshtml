@page
@using JoinIt.Web.Enums
@model JoinIt.Web.Pages.Eventos.IndexModel

@{
    ViewData["Title"] = "Eventos";
}

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<div class="eventos-page-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            EXPLORA
        </p>

        <h1 class="section-title mb-2">
            Eventos
        </h1>

        <p class="text-muted mb-0">
            Descobre eventos públicos por data, local ou categoria.
        </p>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="./Create"
           class="btn btn-primary px-4">
            Criar evento
        </a>
    }
</div>

<div class="card filtros-card mb-5">
    <div class="card-body p-4">

        <div class="mb-4">
            <h2 class="h5 fw-bold mb-1">
                Encontrar eventos
            </h2>

            <p class="text-muted small mb-0">
                Ajusta os filtros para encontrares o evento ideal.
            </p>
        </div>

        <form method="get"
              asp-page="./Index">

            <div class="row">
                <div class="col-lg-4 mb-3">
                    <label asp-for="Pesquisa"
                           class="form-label">
                        Pesquisa
                    </label>

                    <input asp-for="Pesquisa"
                           class="form-control"
                           placeholder="Título, local ou categoria..." />
                </div>

                <div class="col-lg-4 mb-3">
                    <label asp-for="CategoriaId"
                           class="form-label">
                        Categoria
                    </label>

                    <select asp-for="CategoriaId"
                            asp-items="Model.Categorias"
                            class="form-select">

                        <option value="">
                            Todas as categorias
                        </option>
                    </select>
                </div>

                <div class="col-lg-4 mb-3">
                    <label asp-for="Estado"
                           class="form-label">
                        Estado
                    </label>

                    <select asp-for="Estado"
                            class="form-select">

                        <option value="">
                            Todos os estados
                        </option>

                        <option value="@EstadoEvento.ParaBreve">
                            Para breve
                        </option>

                        <option value="@EstadoEvento.ADecorrer">
                            A decorrer
                        </option>

                        <option value="@EstadoEvento.Terminado">
                            Terminado
                        </option>

                        <option value="@EstadoEvento.Cancelado">
                            Cancelado
                        </option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DataDe"
                           class="form-label">
                        Data inicial
                    </label>

                    <input asp-for="DataDe"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="DataAte"
                           class="form-label">
                        Data final
                    </label>

                    <input asp-for="DataAte"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Ordenacao"
                           class="form-label">
                        Ordenar por
                    </label>

                    <select asp-for="Ordenacao"
                            class="form-select">

                        <option value="data-asc">
                            Data mais próxima
                        </option>

                        <option value="data-desc">
                            Data mais distante
                        </option>

                        <option value="nome">
                            Nome
                        </option>

                        <option value="participantes-desc">
                            Mais participantes
                        </option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErroFiltros))
            {
                <div class="alert alert-danger">
                    @Model.ErroFiltros
                </div>
            }

            <div class="d-flex flex-wrap align-items-center gap-4 mb-3">
                <div class="form-check">
                    <input asp-for="ApenasFuturos"
                           class="form-check-input" />

                    <label asp-for="ApenasFuturos"
                           class="form-check-label">
                        Apenas eventos futuros
                    </label>
                </div>

                <div class="form-check">
                    <input asp-for="ComLugares"
                           class="form-check-input" />

                    <label asp-for="ComLugares"
                           class="form-check-label">
                        Apenas com lugares disponíveis
                    </label>
                </div>
            </div>

            <div class="form-text mb-3">
                Ao escolheres um estado específico, o filtro
                “Apenas eventos futuros” é ignorado.
            </div>

            <div class="d-flex flex-wrapgap-2">
                <button type="submit"
                        class="btn btn-primary px-4">
                    Aplicar filtros
                </button>

                <a asp-page="./Index"
                   class="btn btn-outline-secondary">
                    Limpar
                </a>
            </div>

        </form>

    </div>
</div>

<div class="resultados-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            RESULTADOS
        </p>

        <h2 class="h4 fw-bold mb-0">
            Eventos encontrados
        </h2>
    </div>

    <span class="resultados-count">
        @Model.Eventos.Count
        @(Model.Eventos.Count == 1 ? "evento" : "eventos")
    </span>
</div>

@if (Model.Eventos.Count == 0)
{
    <div class="eventos-empty-state">
        <h3 class="h5 fw-bold mb-2">
            Nenhum evento encontrado
        </h3>

        <p class="text-muted mb-3">
            Não existem eventos que correspondam aos filtros selecionados.
        </p>

        <a asp-page="./Index"
           class="btn btn-outline-primary">
            Limpar filtros
        </a>
    </div>
}
else
{
    <div class="row">
        @foreach (var evento in Model.Eventos)
        {
            int numeroParticipantes =
                evento.Participantes.Count(p =>
                    p.Estado == EstadoPedido.Aceite);

            int lugaresDisponiveis = Math.Max(
                0,
                evento.NumMaxParticipantes - numeroParticipantes);

            bool eventoCheio = lugaresDisponiveis == 0;

            string nomeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "Para breve",
                EstadoEvento.ADecorrer => "A decorrer",
                EstadoEvento.Terminado => "Terminado",
                EstadoEvento.Cancelado => "Cancelado",
                _ => evento.Estado.ToString()
            };

            string classeEstado = evento.Estado switch
            {
                EstadoEvento.ParaBreve => "estado-parabreve",
                EstadoEvento.ADecorrer => "estado-decorrer",
                EstadoEvento.Terminado => "estado-terminado",
                EstadoEvento.Cancelado => "estado-cancelado",
                _ => "estado-terminado"
            };

            <div class="col-md-6 col-lg-4 mb-4">
    <article class="card evento-list-card h-100">

        <div class="evento-card-topo"></div>

        <div class="card-body d-flex flex-column p-4">

            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">

                <div class="d-flex flex-wrap gap-1">
                    @foreach (var eventoCategoria in
                        evento.EventosCategorias
                            .OrderBy(ec => ec.Categoria.Nome))
                    {
                        <span class="categoria-badge">
                            @eventoCategoria.Categoria.Nome
                        </span>
                    }
                </div>

                <span class="estado-badge @classeEstado">
                    @nomeEstado
                </span>
            </div>

            <h3 class="h5 fw-bold mb-2">
                @evento.Titulo
            </h3>

            <p class="evento-card-descricao text-muted">
                @evento.Descricao
            </p>

            <div class="evento-card-info mb-3">

                <div class="evento-card-info-row">
                    <span>Início</span>
                    <strong>
                        @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                    </strong>
                </div>

                <div class="evento-card-info-row">
                    <span>Local</span>
                    <strong>@evento.Local</strong>
                </div>

                <div class="evento-card-info-row">
                    <span>Criador</span>

                    <a asp-page="/Users/Details"
                       asp-route-id="@evento.CriadorId">
                        @evento.Criador.Nome
                    </a>
                </div>

                <div class="evento-card-info-row">
                    <span>Participantes</span>
                    <strong>
                        @numeroParticipantes / @evento.NumMaxParticipantes
                    </strong>
                </div>

            </div>

            @if (eventoCheio)
            {
                <div class="evento-lotacao evento-lotado mb-3">
                    Evento lotado
                </div>
            }
            else
            {
                <div class="evento-lotacao evento-disponivel mb-3">
                    @lugaresDisponiveis
                    @(lugaresDisponiveis == 1
                        ? "lugar disponível"
                        : "lugares disponíveis")
                </div>
            }

            <div class="mt-auto">
                <a asp-page="./Details"
                   asp-route-id="@evento.Id"
                   class="btn btn-primary w-100">
                    Ver detalhes
                </a>
            </div>

        </div>
    </article>
</div>
        }
    </div>
}