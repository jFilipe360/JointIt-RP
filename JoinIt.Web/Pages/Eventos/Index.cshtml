@page
@model JoinIt.Web.Pages.Eventos.IndexModel

@{
    ViewData["Title"] = "Eventos";
}

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Eventos</h1>
        <p class="text-muted">
            Descobre os próximos eventos.
        </p>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="./Create" class="btn btn-primary">
            Criar evento
        </a>
    }
</div>

@if (Model.Eventos.Count == 0)
{
    <div class="alert alert-info">
        Ainda não existem eventos disponíveis.
    </div>
}
else
{
    <div class="row">
        @foreach (var evento in Model.Eventos)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">
                        <h5 class="card-title">
                            @evento.Titulo
                        </h5>

                        <p class="card-text">
                            @evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @evento.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            <strong>Criador:</strong>
                            @evento.Criador.Nome
                        </p>

                        <p class="mb-1">
                            <strong>Lotação:</strong>
                            @evento.NumMaxParticipantes participantes
                        </p>

                        <p class="mb-2">
                            <strong>Estado:</strong>
                            @evento.Estado
                        </p>

                        @if (evento.IsPrivado)
                        {
                            <span class="badge bg-warning text-dark mb-2">
                                Privado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success mb-2">
                                Público
                            </span>
                        }

                        <div class="mt-2">
                            @foreach (var eventoCategoria
                                in evento.EventosCategorias)
                            {
                                <span class="badge bg-secondary">
                                    @eventoCategoria.Categoria.Nome
                                </span>
                            }
                        </div>

                        <div class="mt-3">
                            <a asp-page="./Details"
                               asp-route-id="@evento.Id"
                               class="btn btn-outline-primary">
                                Ver detalhes
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}