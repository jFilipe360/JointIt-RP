@page
@using JoinIt.Web.Enums
@using JoinIt.Web.ViewModels
@model JoinIt.Web.Pages.Convites.IndexModel

@{
    ViewData["Title"] = "Convites";
}

<div class="mb-5">
    <p class="section-kicker mb-1">
        EVENTOS PRIVADOS
    </p>

    <h1 class="section-title mb-2">
        Convites
    </h1>

    <p class="text-muted mb-0">
        Gere os convites recebidos para eventos privados.
    </p>
</div>

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success">
        @mensagemSucesso
    </div>
}

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger">
        @mensagemErro
    </div>
}

<div class="convites-section-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            A AGUARDAR RESPOSTA
        </p>

        <h2 class="h4 fw-bold mb-0">
            Convites pendentes
        </h2>
    </div>

    <span class="resultados-count">
        @Model.ConvitesPendentes.Count
    </span>
</div>

@if (Model.ConvitesPendentes.Count == 0)
{
    <div class="eventos-empty-state mb-5">
        <h3 class="h5 fw-bold mb-2">
            Nenhum convite pendente
        </h3>

        <p class="text-muted mb-0">
            Não tens convites para responder neste momento.
        </p>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        @foreach (var convite in Model.ConvitesPendentes)
        {
            var avatarEmissor = new AvatarUtilizadorViewModel
            {
                Nome = convite.Emissor.Nome,
                FotoPerfil = convite.Emissor.FotoPerfil,
                Tamanho = 60
            };
            <div class="col-md-6 col-lg-4">
                <div class="card convite-card convite-pendente-card h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <partial name="_UserAvatar"
                                     model="avatarEmissor" />

                            <div class="text-start">
                                <strong>@convite.Emissor.Nome</strong>

                                <div class="text-muted small">
                                    convidou-te para um evento
                                </div>
                            </div>
                        </div>
                        <h3 class="h5 fw-bold convite-evento-titulo">
                            @convite.Evento.Titulo
                        </h3>

                        <p class="evento-card-descricao text-muted">
                            @convite.Evento.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Criador:</strong>

                            <a asp-page="/Users/Details"
                               asp-route-id="@convite.EmissorId">
                                @convite.Emissor.Nome
                            </a>
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @convite.Evento.DataHora.ToString(
                                "dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-3">
                            <strong>Convite recebido:</strong>
                            @convite.CriadoEm.ToString(
                                "dd/MM/yyyy HH:mm")
                        </p>

                        <div class="mb-3">
                            <span class="convite-status convite-status-pendente">
                                Pendente
                            </span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-auto convite-actions">
                            <a asp-page="/Eventos/Details"
                               asp-route-id="@convite.EventoId"
                               class="btn btn-primary">
                                Ver evento
                            </a>

                            <form method="post"
                                  asp-page-handler="Aceitar"
                                  asp-route-id="@convite.Id">

                                <button type="submit"
                                        class="btn btn-outline-primary">
                                    Aceitar
                                </button>
                            </form>

                            <form method="post"
                                  asp-page-handler="Rejeitar"
                                  asp-route-id="@convite.Id"
                                  onsubmit="return confirm('Pretendes rejeitar este convite?');">

                                <button type="submit"
                                        class="btn btn-outline-danger">
                                    Rejeitar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="convites-section-header mb-4">
    <div>
        <p class="section-kicker mb-1">
            HISTÓRICO
        </p>

        <h2 class="h4 fw-bold mb-0">
            Convites respondidos
        </h2>
    </div>

    <span class="resultados-count">
        @Model.HistoricoConvites.Count
    </span>
</div>

@if (Model.HistoricoConvites.Count == 0)
{
    <div class="eventos-empty-state">
        <h3 class="h5 fw-bold mb-2">
            Sem histórico
        </h3>

        <p class="text-muted mb-0">
            Ainda não tens convites respondidos.
        </p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var convite in Model.HistoricoConvites)
        {
            var avatarEmissor = new AvatarUtilizadorViewModel
            {
                Nome = convite.Emissor.Nome,
                FotoPerfil = convite.Emissor.FotoPerfil,
                Tamanho = 50
            };
            <div class="col-md-6 col-lg-4">
                <div class="card convite-card h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <partial name="_UserAvatar"
                                     model="avatarEmissor" />

                            <a asp-page="/Users/Details"
                               asp-route-id="@convite.EmissorId"
                               class="fw-bold text-decoration-none">
                                @convite.Emissor.Nome
                            </a>
                        </div>
                        <h3 class="h5 fw-bold convite-evento-titulo">
                            @convite.Evento.Titulo
                        </h3>

                        <p class="mb-1">
                            <strong>Criador:</strong>
                            @convite.Emissor.Nome
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @convite.Evento.DataHora.ToString(
                                "dd/MM/yyyy HH:mm")
                        </p>

                        @if (convite.RespondidoEm.HasValue)
                        {
                            <p class="mb-3">
                                <strong>Respondido:</strong>
                                @convite.RespondidoEm.Value.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </p>
                        }

                        @if (convite.Estado == EstadoPedido.Aceite)
                        {
                            <span class="convite-status convite-status-aceite mb-3">
                                Aceite
                            </span>

                            <div>
                                <a asp-page="/Eventos/Details"
                                   asp-route-id="@convite.EventoId"
                                   class="btn btn-primary">
                                    Ver evento
                                </a>
                            </div>
                        }
                        else
                        {
                            <span class="convite-status convite-status-rejeitado">
                                Rejeitado
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}