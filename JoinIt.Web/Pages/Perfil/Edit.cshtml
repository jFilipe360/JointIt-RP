@page
@model JoinIt.Web.Pages.Perfil.EditModel

@{
    ViewData["Title"] = "Editar perfil";

    string inicial =
        string.IsNullOrWhiteSpace(Model.Input.Nome)
            ? "?"
            : Model.Input.Nome[..1].ToUpper();
}

<div class="evento-form-header mb-4">
    <p class="section-kicker mb-1">
        A TUA CONTA
    </p>

    <h1 class="section-title mb-2">
        Editar perfil
    </h1>

    <p class="text-muted mb-0">
        Altera o teu nome e a fotografia de perfil.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <form method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="card perfil-edit-card mb-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="evento-form-section-title">
                        Fotografia de perfil
                    </h2>

                    @if (string.IsNullOrWhiteSpace(Model.FotoAtual))
                    {
                        <div class="perfil-edit-avatar perfil-edit-avatar-placeholder mb-4">
                            @inicial
                        </div>
                    }
                    else
                    {
                        <img src="@Model.FotoAtual"
                         alt="Fotografia de perfil"
                         class="perfil-edit-avatar mb-4" />
                    }

                    <div class="mb-3">
                        <label asp-for="Input.Foto"
                            class="form-label">
                        </label>

                        <input asp-for="Input.Foto"
                            class="form-control perfil-file-input"
                            type="file"
                            accept=".jpg,.jpeg,.png,.webp" />

                        <div class="form-text">
                            Formatos permitidos: JPG, PNG e WEBP.
                            Tamanho máximo: 2 MB.
                        </div>

                        <span asp-validation-for="Input.Foto"
                              class="text-danger">
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.FotoAtual))
                    {
                        <div class="perfil-remover-foto">
                            <div class="form-check">
                                <input asp-for="Input.RemoverFoto"
                                       class="form-check-input" />

                                <label asp-for="Input.RemoverFoto"
                                       class="form-check-label">
                                </label>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <div class="card perfil-edit-card mb-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="evento-form-section-title">
                        Dados pessoais
                    </h2>

                    <div class="mb-3">
                        <label asp-for="Input.Nome"
                               class="form-label">
                        </label>

                        <input asp-for="Input.Nome"
                               class="form-control"
                               autocomplete="name" />

                        <span asp-validation-for="Input.Nome"
                              class="text-danger">
                        </span>
                    </div>

                </div>
            </div>

            <div class="perfil-edit-actions d-flex flex-wrap gap-2">
                <button type="submit"
                        class="btn btn-primary px-4">
                    Guardar alterações
                </button>

                <a asp-page="./Index"
                   class="btn btn-secondary px-4">
                    Cancelar
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}