@page
@model JoinIt.Web.Pages.Perfil.EditModel

@{
    ViewData["Title"] = "Editar perfil";

    string inicial =
        string.IsNullOrWhiteSpace(Model.Input.Nome)
            ? "?"
            : Model.Input.Nome[..1].ToUpper();
}

<h1>Editar perfil</h1>

<p class="text-muted mb-4">
    Altera o teu nome e a fotografia de perfil.
</p>

<div class="row">
    <div class="col-lg-7">

        <form method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="card-title mb-3">
                        Fotografia atual
                    </h5>

                    @if (string.IsNullOrWhiteSpace(Model.FotoAtual))
                    {
                        <div class="rounded-circle bg-secondary text-white
                                    d-flex align-items-center justify-content-center
                                    mb-3"
                             style="width: 130px;
                                    height: 130px;
                                    font-size: 3rem;">

                            @inicial
                        </div>
                    }
                    else
                    {
                        <img src="@Model.FotoAtual"
                             alt="Fotografia de perfil"
                             class="rounded-circle mb-3"
                             style="width: 130px;
                                    height: 130px;
                                    object-fit: cover;" />
                    }

                    <div class="mb-3">
                        <label asp-for="Input.Foto"
                               class="form-label">
                        </label>

                        <input asp-for="Input.Foto"
                               class="form-control"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <div class="form-text">
                            Formatos permitidos: JPG, PNG e WEBP.
                            Tamanho máximo: 2 MB.
                        </div>

                        <span asp-validation-for="Input.Foto"
                              class="text-danger">
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.FotoAtual))
                    {
                        <div class="form-check">
                            <input asp-for="Input.RemoverFoto"
                                   class="form-check-input" />

                            <label asp-for="Input.RemoverFoto"
                                   class="form-check-label">
                            </label>
                        </div>
                    }

                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="card-title mb-3">
                        Dados pessoais
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Input.Nome"
                               class="form-label">
                        </label>

                        <input asp-for="Input.Nome"
                               class="form-control"
                               autocomplete="name" />

                        <span asp-validation-for="Input.Nome"
                              class="text-danger">
                        </span>
                    </div>

                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    Guardar alterações
                </button>

                <a asp-page="./Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}