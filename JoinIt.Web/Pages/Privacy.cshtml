@page
@{
    ViewData["Title"] = "Sobre";
}

<div class="evento-form-header mb-4">
    <p class="section-kicker mb-1">
        SOBRE O PROJETO
    </p>

    <h1 class="section-title mb-2">
        JoinIt
    </h1>

    <p class="text-muted mb-0">
        Projeto desenvolvido no âmbito da unidade curricular
        de Desenvolvimento Web.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">

        <div class="card evento-details-card">
            <div class="card-body p-4 p-md-5">

                <h2 class="evento-form-section-title">
                    Informação do projeto
                </h2>

                <dl class="row mb-0">

                    <dt class="col-sm-4 mb-2">
                        Projeto
                    </dt>

                    <dd class="col-sm-8 mb-3">
                        JoinIt
                    </dd>

                    <dt class="col-sm-4 mb-2">
                        Componente
                    </dt>

                    <dd class="col-sm-8 mb-3">
                        Web
                    </dd>

                    <dt class="col-sm-4 mb-2">
                        Curso
                    </dt>

                    <dd class="col-sm-8 mb-3">
                        Licenciatura em Engenharia Informática
                    </dd>

                    <dt class="col-sm-4 mb-2">
                        Unidade curricular
                    </dt>

                    <dd class="col-sm-8 mb-3">
                        Desenvolvimento Web
                    </dd>

                    <dt class="col-sm-4 mb-2">
                        Ano letivo
                    </dt>

                    <dd class="col-sm-8 mb-3">
                        2025/2026
                    </dd>

                    <dt class="col-sm-4 mb-2">
                        Autor
                    </dt>

                    <dd class="col-sm-8 mb-3">
                        João Filipe Gonçalves Correia
                    </dd>

                    <dt class="col-sm-4 mb-2">
                        Número de aluno
                    </dt>

                    <dd class="col-sm-8 mb-0">
                        21302
                    </dd>

                </dl>

            </div>
        </div>

        <div class="card evento-details-card mt-4">
            <div class="card-body p-4 p-md-5">

                <h2 class="evento-form-section-title">
                    Tecnologias e bibliotecas
                </h2>

                <div class="row fw-bold border-bottom pb-2 mb-3">
                    <div class="col-md-3">
                        Tecnologia
                    </div>

                    <div class="col-md-6">
                        Utilização
                    </div>

                    <div class="col-md-3">
                        Origem
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        ASP.NET Core Razor Pages
                    </div>

                    <div class="col-md-6">
                        Framework principal da aplicação Web.
                    </div>

                    <div class="col-md-3">
                        <a href="https://learn.microsoft.com/aspnet/core/razor-pages/"
                           target="_blank"
                           rel="noopener noreferrer">
                            Microsoft
                        </a>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        Entity Framework Core
                    </div>

                    <div class="col-md-6">
                        Acesso e persistência de dados.
                    </div>

                    <div class="col-md-3">
                        <a href="https://learn.microsoft.com/ef/core/"
                           target="_blank"
                           rel="noopener noreferrer">
                            Microsoft
                        </a>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        ASP.NET Core Identity
                    </div>

                    <div class="col-md-6">
                        Autenticação e gestão de utilizadores.
                    </div>

                    <div class="col-md-3">
                        <a href="https://learn.microsoft.com/aspnet/core/security/authentication/identity"
                           target="_blank"
                           rel="noopener noreferrer">
                            Microsoft
                        </a>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        SignalR
                    </div>

                    <div class="col-md-6">
                        Comunicação em tempo real para chat e notificações.
                    </div>

                    <div class="col-md-3">
                        <a href="https://learn.microsoft.com/aspnet/core/signalr/"
                           target="_blank"
                           rel="noopener noreferrer">
                            Microsoft
                        </a>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        Bootstrap
                    </div>

                    <div class="col-md-6">
                        Componentes e layout da interface.
                    </div>

                    <div class="col-md-3">
                        <a href="https://getbootstrap.com/"
                           target="_blank"
                           rel="noopener noreferrer">
                            getbootstrap.com
                        </a>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        Bootstrap Icons
                    </div>

                    <div class="col-md-6">
                        Ícones utilizados na interface.
                    </div>

                    <div class="col-md-3">
                        <a href="https://icons.getbootstrap.com/"
                           target="_blank"
                           rel="noopener noreferrer">
                            icons.getbootstrap.com
                        </a>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        Leaflet
                    </div>

                    <div class="col-md-6">
                        Visualização e seleção de localizações em mapas.
                    </div>

                    <div class="col-md-3">
                        <a href="https://leafletjs.com/"
                           target="_blank"
                           rel="noopener noreferrer">
                            leafletjs.com
                        </a>
                    </div>
                </div>

                <div class="row align-items-center mb-3">
                    <div class="col-md-3 fw-semibold">
                        OpenStreetMap
                    </div>

                    <div class="col-md-6">
                        Dados cartográficos utilizados nos mapas.
                    </div>

                    <div class="col-md-3">
                        <a href="https://www.openstreetmap.org/"
                           target="_blank"
                           rel="noopener noreferrer">
                            openstreetmap.org
                        </a>
                    </div>
                </div>

                <div class="row align-items-center">
                    <div class="col-md-3 fw-semibold">
                        MailKit
                    </div>

                    <div class="col-md-6">
                        Envio de emails para recuperação de palavra-passe.
                    </div>

                    <div class="col-md-3">
                        <a href="https://github.com/jstedfast/MailKit"
                           target="_blank"
                           rel="noopener noreferrer">
                            GitHub
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>