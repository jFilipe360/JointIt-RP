<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JoinIt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JoinIt.Web.styles.css" asp-append-version="true" />
</head>

<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="notificacaoToast"
                 class="toast"
                 role="alert"
                 aria-live="assertive"
                 aria-atomic="true">

                <div class="toast-header">
                    <strong class="me-auto"
                            id="notificacaoToastTitulo">
                        Nova notificação
                    </strong>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="toast">
                    </button>
                </div>

                <div class="toast-body"
                     id="notificacaoToastMensagem">
                </div>
            </div>
        </div>
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark joinit-navbar">
            <div class="container">
                <a class="navbar-brand joinit-brand" asp-area="" asp-page="/Index">
                    Join<span>It</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse align-items-lg-center justify-content-between">
                    <ul class="navbar-nav flex-grow-1 joinit-nav-links">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Eventos/Index">
                                Eventos
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Eventos/MyEvents">
                                    Os meus eventos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Users/Index">
                                    Utilizadores
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Amigos/Index">
                                    Amizades
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Convites/Index">
                                    Convites
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning"
                                       asp-page="/Admin/Index">
                                        Administração
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="joinit-main">
            @RenderBody()
        </main>
    </div>

    <footer class="joinit-footer">
        <div class="container">
            <span>&copy; 2026 Join<span class="gold">It</span></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
