<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JoinIt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JoinIt.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark joinit-navbar">
            <div class="container">
                <a class="navbar-brand joinit-brand" asp-area="" asp-page="/Index">
                    Join<span>It</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse align-items-lg-center justify-content-between">
                    <ul class="navbar-nav flex-grow-1 joinit-nav-links">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Eventos/Index">
                                Eventos
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Eventos/MyEvents">
                                    Os meus eventos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Users/Index">
                                    Utilizadores
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Amigos/Index">
                                    Amizades
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Convites/Index">
                                    Convites
                                </a>
                            </li>
                            <li class="nav-item">
                                @await Component.InvokeAsync("NotificacaoCount")
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="joinit-main">
            @RenderBody()
        </main>
    </div>

    <footer class="joinit-footer">
        <div class="container">
            <span>&copy; 2026 Join<span class="gold">It</span></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
