@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar palavra-passe";
}

<div class="auth-page-header text-center mb-4">
    <p class="section-kicker mb-1">
        RECUPERAÇÃO DE CONTA
    </p>

    <h1 class="section-title mb-2">
        Recuperar palavra-passe
    </h1>

    <p class="text-muted mb-0">
        Introduz o email associado à tua conta.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">

        <section class="auth-card">

            <form method="post">

                <h2 class="auth-card-title">
                    Esqueceste-te da palavra-passe?
                </h2>

                <p class="text-muted mb-4">
                    Enviaremos um link para definires uma nova palavra-passe.
                </p>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert">
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="nome@exemplo.com" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="w-100 btn btn-primary auth-submit">
                    Enviar link de recuperação
                </button>

                <div class="auth-links mt-4 text-center">
                    <a asp-page="./Login">
                        Voltar ao login
                    </a>
                </div>

            </form>

        </section>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
