@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="evento-form-header mb-4">
    <p class="section-kicker mb-1">
        SEGURANÇA
    </p>

    <h1 class="section-title mb-2">
        Alterar palavra-passe
    </h1>

    <p class="text-muted mb-0">
        Define uma nova palavra-passe para a tua conta.
    </p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">

        <div class="card perfil-edit-card">
            <div class="card-body p-4 p-md-5">

                <form id="change-password-form"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.OldPassword"
                               class="form-label">
                            Palavra-passe atual
                        </label>

                        <input asp-for="Input.OldPassword"
                               class="form-control"
                               autocomplete="current-password"
                               aria-required="true" />

                        <span asp-validation-for="Input.OldPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword"
                               class="form-label">
                            Nova palavra-passe
                        </label>

                        <input asp-for="Input.NewPassword"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true" />

                        <span asp-validation-for="Input.NewPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword"
                               class="form-label">
                            Confirmar nova palavra-passe
                        </label>

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true" />

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-primary px-4">
                            Alterar palavra-passe
                        </button>

                        <a asp-area=""
                           asp-page="/Perfil/Edit"
                           class="btn btn-secondary px-4">
                            Cancelar
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
