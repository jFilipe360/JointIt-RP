@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Palavra-passe redefinida";
}

<div class="auth-page-header text-center mb-4">
    <p class="section-kicker mb-1">
        CONTA ATUALIZADA
    </p>

    <h1 class="section-title mb-2">
        Palavra-passe redefinida
    </h1>

    <p class="text-muted mb-0">
        A palavra-passe da tua conta foi alterada com sucesso.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">

        <section class="auth-card text-center">

            <div class="mb-3">
                <i class="bi bi-shield-check fs-1"></i>
            </div>

            <h2 class="auth-card-title">
                Tudo pronto
            </h2>

            <p class="text-muted mb-4">
                Já podes iniciar sessão com a tua nova palavra-passe.
            </p>

            <a asp-page="./Login"
               class="btn btn-primary">
                Entrar
            </a>

        </section>

    </div>
</div>