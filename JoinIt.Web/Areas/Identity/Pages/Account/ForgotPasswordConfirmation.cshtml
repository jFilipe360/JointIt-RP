@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Verifica o teu email";
}

<div class="auth-page-header text-center mb-4">
    <p class="section-kicker mb-1">
        RECUPERAÇÃO DE CONTA
    </p>

    <h1 class="section-title mb-2">
        Verifica o teu email
    </h1>

    <p class="text-muted mb-0">
        Se existir uma conta associada ao email indicado,
        receberás uma mensagem com as instruções para
        redefinir a palavra-passe.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">

        <section class="auth-card text-center">

            <div class="mb-3">
                <i class="bi bi-envelope-check fs-1"></i>
            </div>

            <h2 class="auth-card-title">
                Email enviado
            </h2>

            <p class="text-muted mb-4">
                Consulta a tua caixa de entrada e segue o link
                enviado pelo JoinIt.
            </p>

            <a asp-page="./Login"
               class="btn btn-primary">
                Voltar ao login
            </a>

        </section>

    </div>
</div>